# Database (same Render Postgres used by FastAPI)
DATABASE_URL=postgresql://user:password@host:5432/airoadcall

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Mapbox
# Preferred for DigitalOcean and local builds; `next.config.js` exposes this to client map components.
MAPBOX_ACCESS_TOKEN=pk.xxx
# Optional direct Next.js public override.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxx

# FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# App
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_HELP_PHONE=(866) 613-5299
NEXT_PUBLIC_COMPANY_PHONE=(866) 415-9494

# GHL public onboarding/sign-in links
# Get Started should usually be a GHL calendar, form, funnel, or onboarding entry point.
NEXT_PUBLIC_GHL_GET_STARTED_URL=https://example.gohighlevel.com/widget/form/roadcall-get-started
# Sign In should be your GHL client/provider portal URL when ready.
NEXT_PUBLIC_GHL_SIGN_IN_URL=https://example.gohighlevel.com/client-portal
# Optional provider-specific fallback used by /provider/register.
NEXT_PUBLIC_GHL_PROVIDER_SIGNUP=https://example.gohighlevel.com/widget/form/provider-signup
