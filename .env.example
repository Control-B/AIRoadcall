# ╔══════════════════════════════════════════════════════════╗
# ║  AI Roadside Support — Environment Variables            ║
# ║  Copy to .env and fill in your values                   ║
# ║  Used by: docker compose up                             ║
# ╚══════════════════════════════════════════════════════════╝

# ── PostgreSQL (DigitalOcean Managed DB) ──────────────────
# Paste your DO Database connection string here
# Format: postgresql://user:password@host:25060/dbname?sslmode=require
DATABASE_URL=postgresql://airoadcall:airoadcall@localhost:5432/airoadcall

# Legacy (only used if running local Docker postgres)
POSTGRES_USER=airoadcall
POSTGRES_PASSWORD=airoadcall
POSTGRES_DB=airoadcall

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── LiveKit Cloud AI Telephony ────────────────────────────
LIVEKIT_API_KEY=APIxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_SIP_TRUNK_ID=ST_xxxx
LIVEKIT_OUTBOUND_AGENT_ID=outbound-mechanic-agent
LIVEKIT_DRIVER_PROMPT_SOURCE=repo
AGENT_NUM_IDLE_PROCESSES=2
# Must match the agent worker (agent/WorkerOptions); required for outbound AI dispatch
LIVEKIT_AGENT_NAME=roadcall-agent

# ── LiveKit Console instructions (sync to the worker) ─────────────────
# The Python worker does not read the LiveKit dashboard UI directly. Use ONE of:
# (1) Paste the same text as in Console → Agents → Instructions into LIVEKIT_CLOUD_INSTRUCTIONS
#     on BOTH the backend and the livekit-agent worker (DigitalOcean env vars).
# (2) Configure your SIP dispatch rule in LiveKit with roomConfig.agents[].metadata as JSON, e.g.
#     {"instructions":"...","welcome_message":"Thank you for calling..."}
#     See: https://docs.livekit.io/telephony/accepting-calls/dispatch-rule/
# Backend also sends instructions on outbound mechanic calls if LIVEKIT_CLOUD_INSTRUCTIONS is set.
# LIVEKIT_CLOUD_INSTRUCTIONS="Your name is Mara..."
# LIVEKIT_AGENT_DISPATCH_METADATA_EXTRA={"welcome_message":"Thank you for calling Roadside..."}

# Driver-intake overrides (optional; used when LIVEKIT_CLOUD_INSTRUCTIONS and job metadata are empty)
# AGENT_DRIVER_INTAKE_PROMPT="..."
# AGENT_DRIVER_INTAKE_PROMPT_FILE=/path/to/prompt.txt
# AGENT_DRIVER_OPENING_INSTRUCTION=A truck driver or motorist just called...

# LiveKit Inference — required for the self-hosted Python agent worker to speak (STT/LLM/TTS).
# This is separate from the optional “Agents” UI in LiveKit Cloud; the worker still needs models here.
LIVEKIT_INFERENCE_LLM=openai/gpt-4o-mini
LIVEKIT_INFERENCE_STT=deepgram/nova-2-phonecall
LIVEKIT_INFERENCE_TTS=elevenlabs/eleven_multilingual_v2
LIVEKIT_INFERENCE_TTS_VOICE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_API_KEY=sk_xxx

# ── Twilio SMS ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+18666501939

# ── Mapbox ────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxx

# ── Apify (bulk mechanic data) ───────────────────────────
APIFY_API_TOKEN=apify_xxx

# ── Tavily (real-time enrichment) ─────────────────────────
TAVILY_API_KEY=tvly_xxx

# ── App ───────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
MAGIC_LINK_SECRET=change-this-to-a-secure-random-string
MAGIC_LINK_EXPIRY_HOURS=24
MECHANIC_ARRIVAL_THRESHOLD_METERS=200
FRONTEND_URL=http://localhost:3000
