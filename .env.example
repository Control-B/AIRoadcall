# ╔══════════════════════════════════════════════════════════╗
# ║  AI Roadside Support — Environment Variables            ║
# ║  Copy to .env and fill in your values                   ║
# ║  Used by: docker compose up                             ║
# ╚══════════════════════════════════════════════════════════╝

# ── PostgreSQL (DigitalOcean Managed DB) ──────────────────
# Paste your DO Database connection string here
# Format: postgresql://user:password@host:25060/dbname?sslmode=require
DATABASE_URL=postgresql://airoadcall:airoadcall@localhost:5432/airoadcall

# Legacy (only used if running local Docker postgres)
POSTGRES_USER=airoadcall
POSTGRES_PASSWORD=airoadcall
POSTGRES_DB=airoadcall

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── LiveKit Cloud AI Telephony ────────────────────────────
LIVEKIT_API_KEY=APIxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_SIP_TRUNK_ID=ST_xxxx
LIVEKIT_OUTBOUND_AGENT_ID=outbound-mechanic-agent
# Must match the agent worker (agent/WorkerOptions); required for outbound AI dispatch
LIVEKIT_AGENT_NAME=roadcall-agent

# LiveKit Inference — required for the self-hosted Python agent worker to speak (STT/LLM/TTS).
# This is separate from the optional “Agents” UI in LiveKit Cloud; the worker still needs models here.
LIVEKIT_INFERENCE_LLM=openai/gpt-4o-mini
LIVEKIT_INFERENCE_STT=deepgram/nova-2-phonecall
LIVEKIT_INFERENCE_TTS=cartesia/sonic-3
# LIVEKIT_INFERENCE_TTS_VOICE=your-cartesia-voice-id

# ── Twilio SMS ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+1234567890

# ── Mapbox ────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxx

# ── Apify (bulk mechanic data) ───────────────────────────
APIFY_API_TOKEN=apify_xxx

# ── Tavily (real-time enrichment) ─────────────────────────
TAVILY_API_KEY=tvly_xxx

# ── App ───────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
MAGIC_LINK_SECRET=change-this-to-a-secure-random-string
MAGIC_LINK_EXPIRY_HOURS=24
MECHANIC_ARRIVAL_THRESHOLD_METERS=200
FRONTEND_URL=http://localhost:3000
