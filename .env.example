# ╔══════════════════════════════════════════════════════════╗
# ║  AI Roadside Support — Environment Variables            ║
# ║  Copy to .env and fill in your values                   ║
# ║  Used by: docker compose up                             ║
# ╚══════════════════════════════════════════════════════════╝

# ── PostgreSQL (DigitalOcean Managed DB) ──────────────────
# Paste your DO Database connection string here
# Format: postgresql://user:password@host:25060/dbname?sslmode=require
DATABASE_URL=postgresql://airoadcall:airoadcall@localhost:5432/airoadcall

# Legacy (only used if running local Docker postgres)
POSTGRES_USER=airoadcall
POSTGRES_PASSWORD=airoadcall
POSTGRES_DB=airoadcall

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx


# ── Twilio SMS ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+18666501939

# ── Mapbox ────────────────────────────────────────────────
# Preferred for backend geocoding and frontend map builds.
MAPBOX_ACCESS_TOKEN=pk.xxx
# Optional direct Next.js public override.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxx

# ── Apify (bulk mechanic data) ───────────────────────────
APIFY_API_TOKEN=apify_xxx

# ── Tavily (real-time enrichment) ─────────────────────────
TAVILY_API_KEY=tvly_xxx

# ── App ───────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
ROADCALL_BACKEND_API_URL=http://localhost:8000/api
ROADCALL_ONBOARDING_WEBHOOK_URL=https://example.gohighlevel.com/widget/form/roadcall-onboarding-webhook
MAGIC_LINK_SECRET=change-this-to-a-secure-random-string
MAGIC_LINK_EXPIRY_HOURS=24
MECHANIC_ARRIVAL_THRESHOLD_METERS=200
DEMO_AUTO_ASSIGN_NEAREST_MECHANIC=true
DEMO_SKIP_PAYMENT_AUTHORIZATION=true
JOB_DUPLICATE_WINDOW_MINUTES=15
FRONTEND_URL=http://localhost:3000
