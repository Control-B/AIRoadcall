# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/airoadcall

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# LiveKit Cloud AI Telephony
LIVEKIT_API_KEY=APIxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_SIP_TRUNK_ID=ST_xxxx
LIVEKIT_OUTBOUND_AGENT_ID=outbound-mechanic-agent
LIVEKIT_AGENT_NAME=roadcall-agent
# Same text as LiveKit Console → Agents → Instructions; sent on outbound agent dispatch metadata.
# LIVEKIT_CLOUD_INSTRUCTIONS=
# Optional JSON merged into dispatch metadata: LIVEKIT_AGENT_DISPATCH_METADATA_EXTRA={"welcome_message":"..."}

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+18666501939

# Apify
APIFY_API_TOKEN=apify_xxx

# Tavily
TAVILY_API_KEY=tvly_xxx

# App
APP_BASE_URL=http://localhost:3000
MAGIC_LINK_SECRET=change-this-to-a-secure-random-string
MAGIC_LINK_EXPIRY_HOURS=24
MECHANIC_ARRIVAL_THRESHOLD_METERS=200

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
